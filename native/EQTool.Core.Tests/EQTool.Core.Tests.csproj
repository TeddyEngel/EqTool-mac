    <Compile Include="..\..\EQtoolsTests\ParsingTests.cs"                 LinkBase="Upstream" />
    <Compile Include="..\..\EQtoolsTests\PathsTests.cs"                   LinkBase="Upstream" />
    <Compile Include="..\..\EQtoolsTests\PetTests.cs"                     LinkBase="Upstream" />
    <Compile Include="..\..\EQtoolsTests\PlayerLevelDetectionParserTests.cs" LinkBase="Upstream" />
    <Compile Include="..\..\EQtoolsTests\PlayerWhoLogParseTests.cs"       LinkBase="Upstream" />
    <Compile Include="..\..\EQtoolsTests\RandomRollTests.cs"              LinkBase="Upstream" />
    <Compile Include="..\..\EQtoolsTests\SlainHandlerTests.cs"            LinkBase="Upstream" />
    <Compile Include="..\..\EQtoolsTests\SpellAdaptiveGroupingTests.cs"   LinkBase="Upstream" />
