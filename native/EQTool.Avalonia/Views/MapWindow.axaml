<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EQTool.Avalonia.ViewModels"
        xmlns:controls="using:EQTool.Avalonia.Controls"
        x:Class="EQTool.Avalonia.Views.MapWindow"
        x:DataType="vm:MapWindowViewModel"
        Title="PigParse Map"
        Width="760"
        Height="620"
        MinWidth="360"
        MinHeight="280"
        Background="{StaticResource BrushWindowGround}">

  <Window.Styles>

    <Style Selector="TextBlock.eyebrow">
      <Setter Property="FontFamily" Value="{StaticResource FontUI}" />
      <Setter Property="FontSize" Value="{DynamicResource TypeMicro}" />
      <Setter Property="LetterSpacing" Value="2" />
      <Setter Property="Foreground" Value="{StaticResource BrushTextFaint}" />
    </Style>

    <Style Selector="TextBlock.zone">
      <Setter Property="FontFamily" Value="{StaticResource FontDisplay}" />
      <Setter Property="FontSize" Value="{DynamicResource TypeHeading}" />
      <Setter Property="FontWeight" Value="DemiBold" />
      <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
    </Style>

    <Style Selector="TextBlock.notice">
      <Setter Property="FontFamily" Value="{StaticResource FontUI}" />
      <Setter Property="FontSize" Value="{DynamicResource TypeCaption}" />
      <Setter Property="Foreground" Value="{StaticResource BrushSignalAmber}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="Button.ghost">
      <Setter Property="FontFamily" Value="{StaticResource FontUI}" />
      <Setter Property="FontSize" Value="{DynamicResource TypeMicro}" />
      <Setter Property="Foreground" Value="{StaticResource BrushSignalAmber}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{StaticResource BrushLineHair}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="{StaticResource InsetButton}" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}" />
    </Style>

    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource BrushSurfaceRaised}" />
    </Style>

  </Window.Styles>

  <Grid RowDefinitions="Auto,Auto,*">

    <Border Grid.Row="0"
            Background="{StaticResource BrushHeaderGround}"
            BorderBrush="{StaticResource BrushLineHair}"
            BorderThickness="{StaticResource RuleBottom}"
            Padding="{StaticResource InsetHeader}">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Orientation="Vertical" Spacing="2">
          <TextBlock Classes="eyebrow" Text="ZONE MAP" />
          <TextBlock Classes="zone"
                     Text="{Binding ZoneName}"
                     IsVisible="{Binding HasZone}" />
          <TextBlock Classes="eyebrow"
                     Text="No zone yet"
                     IsVisible="{Binding !HasZone}" />
        </StackPanel>
        <Button Grid.Column="1"
                Name="ResetViewButton"
                Classes="ghost"
                VerticalAlignment="Center"
                Content="Reset view" />
      </Grid>
    </Border>

    <Border Grid.Row="1"
            IsVisible="{Binding HasNotice}"
            Background="{StaticResource BrushSurfaceSunk}"
            BorderBrush="{StaticResource BrushLineHair}"
            BorderThickness="{StaticResource RuleBottom}"
            Padding="{StaticResource InsetList}">
      <TextBlock Classes="notice" Text="{Binding NoticeLine}" />
    </Border>

    <Border Grid.Row="2"
            Background="{StaticResource BrushSurfaceVoid}">
      <controls:ZoneMapControl Name="MapSurface"
                               MapData="{Binding MapData}"
                               PlayerLocation="{Binding PlayerLocation}"
                               PlayerName="{Binding PlayerName}" />
    </Border>

  </Grid>

</Window>
