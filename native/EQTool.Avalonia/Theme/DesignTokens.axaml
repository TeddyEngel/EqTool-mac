<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Design tokens for the native PigParse client.

    Every colour, spacing value, type size and radius used by a view comes from
    this file. Views must not carry literal values: if something new is needed,
    add a token here first.

    Direction: instrument panel. The window sits beside EverQuest, so it reads as
    a piece of hardware rather than a document - near-black blue-grey ground,
    hairline rules, amber as the signal colour, mint as the "healthy" colour.
  -->

  <!-- ============================ Colour ============================ -->

  <Color x:Key="ColorSurfaceVoid">#FF080A0D</Color>
  <Color x:Key="ColorSurfaceSunk">#FF0E1116</Color>
  <Color x:Key="ColorSurfacePanel">#FF141922</Color>
  <Color x:Key="ColorSurfaceRow">#FF19202A</Color>
  <Color x:Key="ColorSurfaceRaised">#FF1F2833</Color>
  <Color x:Key="ColorLineHair">#FF26303C</Color>
  <Color x:Key="ColorLineBright">#FF3A4757</Color>
  <Color x:Key="ColorTextPrimary">#FFE6EDF5</Color>
  <Color x:Key="ColorTextSecondary">#FF93A1B1</Color>
  <Color x:Key="ColorTextFaint">#FF5C6875</Color>
  <Color x:Key="ColorSignalAmber">#FFFFA02E</Color>
  <Color x:Key="ColorSignalMint">#FF62D6A0</Color>
  <Color x:Key="ColorSignalRose">#FFFF5C6C</Color>
  <Color x:Key="ColorInkOnSignal">#FF080A0D</Color>

  <SolidColorBrush x:Key="BrushSurfaceVoid" Color="{StaticResource ColorSurfaceVoid}" />
  <SolidColorBrush x:Key="BrushSurfaceSunk" Color="{StaticResource ColorSurfaceSunk}" />
  <SolidColorBrush x:Key="BrushSurfacePanel" Color="{StaticResource ColorSurfacePanel}" />
  <SolidColorBrush x:Key="BrushSurfaceRow" Color="{StaticResource ColorSurfaceRow}" />
  <SolidColorBrush x:Key="BrushSurfaceRaised" Color="{StaticResource ColorSurfaceRaised}" />
  <SolidColorBrush x:Key="BrushLineHair" Color="{StaticResource ColorLineHair}" />
  <SolidColorBrush x:Key="BrushLineBright" Color="{StaticResource ColorLineBright}" />
  <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}" />
  <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}" />
  <SolidColorBrush x:Key="BrushTextFaint" Color="{StaticResource ColorTextFaint}" />
  <SolidColorBrush x:Key="BrushSignalAmber" Color="{StaticResource ColorSignalAmber}" />
  <SolidColorBrush x:Key="BrushSignalMint" Color="{StaticResource ColorSignalMint}" />
  <SolidColorBrush x:Key="BrushSignalRose" Color="{StaticResource ColorSignalRose}" />
  <SolidColorBrush x:Key="BrushInkOnSignal" Color="{StaticResource ColorInkOnSignal}" />

  <!-- Atmosphere: the window ground is a shallow vertical wash, not a flat fill. -->
  <LinearGradientBrush x:Key="BrushWindowGround" StartPoint="0%,0%" EndPoint="0%,100%">
    <GradientStop Offset="0" Color="{StaticResource ColorSurfaceSunk}" />
    <GradientStop Offset="1" Color="{StaticResource ColorSurfaceVoid}" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="BrushHeaderGround" StartPoint="0%,0%" EndPoint="0%,100%">
    <GradientStop Offset="0" Color="{StaticResource ColorSurfacePanel}" />
    <GradientStop Offset="1" Color="{StaticResource ColorSurfaceSunk}" />
  </LinearGradientBrush>

  <!-- ========================== Typography ========================== -->

  <FontFamily x:Key="FontDisplay">Avenir Next Condensed, Avenir Next, Helvetica Neue</FontFamily>
  <FontFamily x:Key="FontUI">Avenir Next, Helvetica Neue, Lucida Grande</FontFamily>
  <!-- Countdowns use a monospaced face so the digits do not jitter as they tick. -->
  <FontFamily x:Key="FontMono">Menlo, Monaco, Courier New</FontFamily>

  <!--
    The scale is tuned for a window that stands next to a running EverQuest
    client during a raid. A dozen or more timers have to be readable at a
    glance without scrolling, so the countdown is the only thing that gets to
    be large: it is what the player reads under pressure. The group label is
    context and sits at the bottom of the scale.
  -->
  <x:Double x:Key="TypeMicro">9</x:Double>
  <x:Double x:Key="TypeCaption">11</x:Double>
  <x:Double x:Key="TypeBody">12</x:Double>
  <x:Double x:Key="TypeRow">12</x:Double>
  <x:Double x:Key="TypeCountdown">13</x:Double>
  <x:Double x:Key="TypeHeading">16</x:Double>
  <x:Double x:Key="TypeTitle">20</x:Double>

  <!-- ============================ Spacing ============================ -->
  <!-- 2px base, doubling. Nothing in a view may use a value not listed here. -->

  <x:Double x:Key="Space1">2</x:Double>
  <x:Double x:Key="Space2">4</x:Double>
  <x:Double x:Key="Space3">6</x:Double>
  <x:Double x:Key="Space4">8</x:Double>
  <x:Double x:Key="Space5">12</x:Double>
  <x:Double x:Key="Space6">16</x:Double>
  <x:Double x:Key="Space7">24</x:Double>
  <x:Double x:Key="Space8">32</x:Double>

  <!-- Rows carry no vertical inset of their own. SizeRowHeight sets the pitch
       and the row contents centre inside it, so the two cannot fight. -->
  <Thickness x:Key="InsetRow">8,0,8,0</Thickness>
  <Thickness x:Key="InsetPanel">12</Thickness>
  <Thickness x:Key="InsetList">10,4,10,4</Thickness>
  <Thickness x:Key="InsetHeader">14,8,14,8</Thickness>
  <Thickness x:Key="InsetButton">10,4,10,4</Thickness>
  <Thickness x:Key="RuleBottom">0,0,0,1</Thickness>
  <Thickness x:Key="RuleTop">0,1,0,0</Thickness>

  <!-- Gaps between repeated elements, kept out of the views. -->
  <Thickness x:Key="GapRow">0,0,0,1</Thickness>
  <Thickness x:Key="GapRowIcon">0,0,7,0</Thickness>
  <Thickness x:Key="GapRowGroup">8,0,8,0</Thickness>
  <Thickness x:Key="GapHeaderMeta">0,6,0,0</Thickness>
  <Thickness x:Key="GapHeaderMetaSource">10,0,0,0</Thickness>
  <Thickness x:Key="GapSpine">0,0,8,0</Thickness>
  <!-- A console entry wraps over several lines, so the gap between entries has
       to beat the leading inside one or a three-line entry reads as three
       entries. -->
  <Thickness x:Key="GapConsoleEntry">0,0,0,4</Thickness>

  <!-- ===================== Radii and dimensions ===================== -->

  <!-- A row radius any larger than this reads as a gap between rows, and at
       this pitch the list cannot afford one. -->
  <CornerRadius x:Key="RadiusRow">2</CornerRadius>
  <CornerRadius x:Key="RadiusPanel">6</CornerRadius>
  <CornerRadius x:Key="RadiusPill">10</CornerRadius>

  <x:Double x:Key="SizeRowHeight">18</x:Double>
  <x:Double x:Key="SizeSpineWidth">3</x:Double>
  <!-- Spell icons are cut at 40px but drawn at the row's text size, so a row
       carrying one is exactly as tall as a row that does not. -->
  <x:Double x:Key="SizeRowIcon">13</x:Double>
  <!-- Shown in place of an icon the sheets cannot supply. The slot keeps its
       width either way, so every name in the list starts on one left edge and
       an unresolved icon reads as a mark rather than a hole. -->
  <x:Double x:Key="SizeRowIconVoid">4</x:Double>
  <x:Double x:Key="SizeBrandSpineHeight">16</x:Double>
  <!-- Widest countdown the formatter can produce is "1h 2m 3s". -->
  <x:Double x:Key="SizeCountdownColumn">68</x:Double>
  <x:Double x:Key="SizeEmptyRule">40</x:Double>
  <x:Double x:Key="SizeEmptyProseWidth">280</x:Double>
  <!-- Console lines set their own leading rather than taking the row pitch: a
       long line wraps, so the pitch has to come from the line box and not from
       a fixed row height. 14 on 11pt Menlo is the tightest that keeps a
       wrapped continuation readable as part of the same entry. -->
  <x:Double x:Key="SizeConsoleLineHeight">14</x:Double>
  <!-- Mob stats are a label over a value. The column is wide enough for
       "ATTACKS / ROUND" at TypeMicro, which is the longest label the wiki
       template supplies, so the grid stays on two columns at the window's
       minimum width. -->
  <x:Double x:Key="SizeStatColumn">140</x:Double>
  <!-- Loot prices are right-aligned in their own column. The widest figure the
       pricing API returns runs to six digits. -->
  <x:Double x:Key="SizePriceColumn">64</x:Double>

</ResourceDictionary>
