    <Compile Include="..\..\EQTool\ViewModels\MobInfoComponents\MobInfoViewModel.cs" LinkBase="Linked\EQTool\ViewModels\MobInfoComponents" />
    <Compile Include="..\..\EQTool\ViewModels\MobInfoComponents\PetViewModel.cs"    LinkBase="Linked\EQTool\ViewModels\MobInfoComponents" />
  </ItemGroup>

</Project>
