<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RootNamespace>EQTool.Core</RootNamespace>
    <AssemblyName>EQTool.Core</AssemblyName>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <DefineConstants>$(DefineConstants);TEST</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Compat\**\*.cs" />
    <Compile Include="Platform\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\EQToolShared\**\*.cs"
             Exclude="..\..\EQToolShared\**\obj\**\*.cs;..\..\EQToolShared\**\bin\**\*.cs;..\..\EQToolShared\Properties\AssemblyInfo.cs"
             LinkBase="Linked\EQToolShared" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\EQToolShared\Properties\Resources.resx"
                      LogicalName="EQToolShared.Properties.Resources.resources"
                      LinkBase="Linked\EQToolShared\Properties" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\EQTool\Services\Parsing\**\*.cs"
             Exclude="..\..\EQTool\Services\Parsing\**\obj\**\*.cs;..\..\EQTool\Services\Parsing\**\bin\**\*.cs"
             LinkBase="Linked\EQTool\Services\Parsing" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\EQTool\Services\Handlers\**\*.cs"
             Exclude="..\..\EQTool\Services\Handlers\**\obj\**\*.cs;..\..\EQTool\Services\Handlers\**\bin\**\*.cs"
             LinkBase="Linked\EQTool\Services\Handlers" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\EQTool\Models\IEqLogParser.cs"    LinkBase="Linked\EQTool\Models" />
    <Compile Include="..\..\EQTool\Models\EventModels.cs"     LinkBase="Linked\EQTool\Models" />
    <Compile Include="..\..\EQTool\Models\Spell.cs"           LinkBase="Linked\EQTool\Models" />
    <Compile Include="..\..\EQTool\Models\SpellBase.cs"       LinkBase="Linked\EQTool\Models" />
    <Compile Include="..\..\EQTool\Models\SpellIcon.cs"       LinkBase="Linked\EQTool\Models" />
    <Compile Include="..\..\EQTool\Models\EQSpells.cs"        LinkBase="Linked\EQTool\Models" />
    <Compile Include="..\..\EQTool\Models\EQToolSettings.cs"  LinkBase="Linked\EQTool\Models" />
    <Compile Include="..\..\EQTool\Models\PlayerInfo.cs"      LinkBase="Linked\EQTool\Models" />
    <Compile Include="..\..\EQTool\Models\CustomTimer.cs"     LinkBase="Linked\EQTool\Models" />
    <Compile Include="..\..\EQTool\Models\OverlayTypes.cs"    LinkBase="Linked\EQTool\Models" />
    <Compile Include="..\..\EQTool\Models\FightHistory.cs"    LinkBase="Linked\EQTool\Models" />
    <Compile Include="..\..\EQTool\Models\Trigger.cs"         LinkBase="Linked\EQTool\Models" />
    <Compile Include="..\..\EQTool\Models\TriggerFolder.cs"   LinkBase="Linked\EQTool\Models" />
    <Compile Include="..\..\EQTool\Models\TriggerComponents.cs" LinkBase="Linked\EQTool\Models" />
    <Compile Include="..\..\EQTool\Models\TriggerColors.cs"   LinkBase="Linked\EQTool\Models" />
    <Compile Include="..\..\EQTool\Models\BuiltInTriggers.cs" LinkBase="Linked\EQTool\Models" />
    <Compile Include="..\..\EQTool\Models\Pets.cs"            LinkBase="Linked\EQTool\Models" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\EQTool\Services\DebugOutput.cs"        LinkBase="Linked\EQTool\Services" />
    <Compile Include="..\..\EQTool\Services\LogEvents.cs"          LinkBase="Linked\EQTool\Services" />
    <Compile Include="..\..\EQTool\Services\LogParser.cs"          LinkBase="Linked\EQTool\Services" />
    <Compile Include="..\..\EQTool\Services\EQToolSettingsLoad.cs" LinkBase="Linked\EQTool\Services" />
    <Compile Include="..\..\EQTool\Services\FindEq.cs"             LinkBase="Linked\EQTool\Services" />
    <Compile Include="..\..\EQTool\Services\BoatScheduleService.cs" LinkBase="Linked\EQTool\Services" />
